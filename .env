# MOVIE_ALIASES=오디세이,The Odyssey,ODYSSEY
MOVIE_ALIASES=모아나
COMPANY_CODE=A420
SITE_NO=0013
RTCTL_SCOP_CD=08
FORMAT_KEYWORDS=IMAX,아이맥스
ANY_FORMAT=false

# Keep this small and targeted. For very competitive openings, prefer START_DATE/END_DATE.
DAYS_AHEAD=14
START_DATE=20260706
END_DATE=20260710

# Conservative default. Lower values increase block risk.
INTERVAL_SECONDS=1
MIN_INTERVAL_SECONDS=1
MAX_INTERVAL_SECONDS=300
TIMEOUT_MS=8000

# Browser-based automatic header refresh.
# Opens a real browser, captures searchMovScnInfo request headers, and refreshes them every 10 minutes.
AUTO_REFRESH_HEADERS=true
HEADER_REFRESH_INTERVAL_SECONDS=600
# HEADER_REFRESH_INTERVAL_SECONDS=10 # for Test
HEADER_CAPTURE_TIMEOUT_MS=90000
BROWSER_HEADLESS=false
THEATER_SEARCH_NAME=용산아이파크몰

# Manual fallback. If auto refresh is off or fails, copy request headers from Chrome DevTools.
# CGV_COOKIE=...
# CGV_AUTHORIZATION=Bearer ...
# CGV_EXTRA_HEADERS_JSON={"x-example-header":"value"}

# Optional Telegram notification.
# TELEGRAM_BOT_TOKEN=123456:abc...
# TELEGRAM_CHAT_ID=123456789
